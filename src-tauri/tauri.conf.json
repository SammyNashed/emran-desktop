{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emran",
  "version": "1.0.0",
  "identifier": "io.github.sammynashed.emrandesktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "عِمران", "width": 1120, "height": 760, "minWidth": 960, "minHeight": 660, "center": true, "visible": false }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "category": "Lifestyle",
    "shortDescription": "Prayer times and adhan, fully offline",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "license": "GPL-3.0-only",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["Arabic", "English"], "displayLanguageSelector": false }
    },
    "linux": { "appimage": { "bundleMediaFramework": false } }
  }
}
